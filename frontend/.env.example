# frontend/.env.example
# Copie ce fichier en `.env` (ou `.env.local`) dans ce même dossier
# `frontend/` et adapte les valeurs — Vite ne lit les variables
# d'environnement QUE depuis son propre dossier racine (ici), pas depuis
# la racine du projet global. Seules les variables préfixées `VITE_`
# sont exposées au code côté navigateur (accessibles via
# `import.meta.env.VITE_...`) — c'est une contrainte de sécurité de Vite,
# pas une convention arbitraire de ce projet : tout le reste (sans ce
# préfixe) resterait invisible pour le code client de toute façon.

# URL de base de l'API backend. Si absente, le code retombe sur "/api"
# (chemin relatif géré par le proxy de développement dans
# vite.config.js) — définir cette variable devient nécessaire si tu sers
# le frontend et le backend depuis des origines différentes (ex. en
# production, ou un backend qui ne tourne pas sur localhost:3001).
VITE_API_URL=http://localhost:3001/api

# Environnement courant, pour un futur usage (ex. désactiver certains
# logs/fonctionnalités de debug en production) — "development" par
# défaut, aucune logique ne s'y branche encore aujourd'hui.
VITE_APP_ENV=development
